<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>ソフトテニス戦術シミュレーター</title>
<style>
  :root {
    --bg: #0b131e;
    --panel: #131f30;
    --panel2: #1a2940;
    --border: #2a3f5f;
    --text: #f1f5f9;
    --muted: #94a3b8;
    --accent: #10b981;
    --accent2: #38bdf8;
    --warn: #f59e0b;
    --danger: #ef4444;
    --court: #1e6b43;
    --court-out: #13422b;
    --safe-top: env(safe-area-inset-top, 0px);
    --safe-bottom: env(safe-area-inset-bottom, 0px);
  }
  * {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Hiragino Kaku Gothic ProN", sans-serif;
    font-size: 13px;
    line-height: 1.35;
    overflow: hidden;
  }
  button, select, input {
    font-family: inherit;
    color: inherit;
    touch-action: manipulation;
  }
  button {
    cursor: pointer;
    border: 1px solid var(--border);
    background: var(--panel2);
    border-radius: 7px;
    padding: 6px 9px;
    font-size: 12px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    transition: transform 0.06s, background 0.12s;
  }
  button:active { transform: scale(0.96); }
  button.active {
    background: var(--accent);
    border-color: #34d399;
    color: #052e16;
  }
  button.active-blue {
    background: var(--accent2);
    border-color: #7dd3fc;
    color: #082f49;
  }
  button.active-warn {
    background: var(--warn);
    border-color: #fcd34d;
    color: #451a03;
  }
  button.danger {
    background: rgba(239, 68, 68, 0.18);
    border-color: rgba(239, 68, 68, 0.5);
    color: #fca5a5;
  }

  /* App Shell */
  .app {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100dvh;
    padding-top: var(--safe-top);
    padding-bottom: var(--safe-bottom);
  }

  /* Header */
  .hdr {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .hdr-title {
    font-size: 13px;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 5px;
    letter-spacing: 0.02em;
  }
  .badge-ok {
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 99px;
    background: rgba(16, 185, 129, 0.18);
    border: 1px solid rgba(16, 185, 129, 0.5);
    color: #6ee7b7;
    font-weight: 700;
  }

  /* Score & Rotation Strip */
  .score-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 5px 10px;
    background: #0f1928;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .score-box {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .team-tag {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 5px;
  }
  .team-self { background: rgba(56, 189, 248, 0.2); color: #7dd3fc; border: 1px solid rgba(56, 189, 248, 0.4); }
  .team-opp { background: rgba(244, 63, 94, 0.2); color: #fda4af; border: 1px solid rgba(244, 63, 94, 0.4); }
  .pt-btn {
    min-width: 34px;
    padding: 3px 7px;
    font-size: 13px;
    font-weight: 800;
  }
  .game-pill {
    font-size: 11px;
    font-weight: 800;
    color: #fde68a;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.35);
    padding: 2px 7px;
    border-radius: 6px;
  }
  .rot-info {
    font-size: 10px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 5px;
  }

  /* Main Scroll Area */
  .main {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 6px 8px 14px;
  }
  .tab-pane { display: none; }
  .tab-pane.active { display: block; }

  /* Timeline & Speed Bar */
  .tl-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 5px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 5px 7px;
    margin-bottom: 6px;
  }
  .step-pills {
    display: flex;
    align-items: center;
    gap: 4px;
    overflow-x: auto;
    max-width: 100%;
    padding-bottom: 1px;
  }
  .step-pill {
    padding: 4px 8px;
    font-size: 11px;
    white-space: nowrap;
  }
  .play-controls {
    display: flex;
    align-items: center;
    gap: 4px;
    width: 100%;
    justify-content: space-between;
    border-top: 1px solid rgba(42, 63, 95, 0.6);
    padding-top: 5px;
  }
  .speed-group {
    display: flex;
    align-items: center;
    gap: 2px;
    background: #0b131e;
    padding: 2px;
    border-radius: 6px;
    border: 1px solid var(--border);
  }
  .spd-btn {
    border: none;
    background: transparent;
    padding: 3px 6px;
    font-size: 10px;
    color: var(--muted);
    border-radius: 4px;
  }
  .spd-btn.active {
    background: var(--accent2);
    color: #082f49;
  }

  /* Court Container */
  .court-wrap {
    position: relative;
    width: 76%;
    max-width: 340px;
    margin: 0 auto 6px;
    transition: width 0.18s ease, max-width 0.18s ease;
  }
  .court-wrap.expanded {
    width: 98%;
    max-width: 480px;
  }
  .court-wrap.horiz {
    width: 96%;
    max-width: 520px;
  }
  .court-wrap.horiz.expanded {
    width: 100%;
    max-width: 680px;
  }
  .court-svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 2px solid #2e5a44;
    background: var(--court-out);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
    touch-action: pan-y;
  }
  /* Critical: prevent SVG overlays from blocking player drag */
  .court-svg * {
    pointer-events: none;
  }
  .court-svg .player-hit {
    pointer-events: auto;
    cursor: grab;
  }
  .court-svg .player-hit:active {
    cursor: grabbing;
  }

  /* Quick Controls under Court */
  .quick-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 7px 8px;
    margin-bottom: 6px;
  }
  .q-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 5px;
    margin-bottom: 6px;
  }
  .q-row:last-child { margin-bottom: 0; }
  .q-lbl {
    font-size: 11px;
    font-weight: 700;
    color: var(--muted);
    min-width: 52px;
    flex-shrink: 0;
  }
  .btn-group {
    display: flex;
    flex: 1;
    gap: 4px;
    flex-wrap: wrap;
  }
  .btn-group button {
    flex: 1;
    min-width: 44px;
    padding: 5px 4px;
    font-size: 11px;
  }
  input[type="range"] {
    flex: 1;
    accent-color: var(--accent);
    height: 22px;
    margin: 0;
  }
  .val-tag {
    font-size: 11px;
    font-weight: 800;
    color: #6ee7b7;
    min-width: 44px;
    text-align: right;
  }

  /* Tactical Status Banner */
  .diag-box {
    background: rgba(16, 185, 129, 0.09);
    border: 1px solid rgba(16, 185, 129, 0.35);
    border-radius: 8px;
    padding: 6px 8px;
    font-size: 11px;
    margin-bottom: 6px;
  }
  .diag-title {
    font-weight: 800;
    color: #6ee7b7;
    margin-bottom: 2px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .prev-banner {
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 7px;
    padding: 4px 8px;
    font-size: 11px;
    color: #bae6fd;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Settings & Log Cards */
  .card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 9px 10px;
    margin-bottom: 8px;
  }
  .card-h {
    font-size: 12px;
    font-weight: 800;
    color: #e2e8f0;
    margin-bottom: 7px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .log-item {
    background: #0f1928;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 7px 8px;
    margin-bottom: 6px;
  }
  .log-item-hdr {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
    margin-bottom: 4px;
  }
  textarea, input[type="text"] {
    width: 100%;
    background: #0b131e;
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 7px;
    color: var(--text);
    font-size: 12px;
    user-select: text;
    -webkit-user-select: text;
  }

  /* Bottom Slim Nav (Always Visible even when Court Expanded) */
  .nav {
    display: flex;
    align-items: center;
    background: var(--panel);
    border-top: 1px solid var(--border);
    height: 40px;
    flex-shrink: 0;
  }
  .nav-btn {
    flex: 1;
    height: 100%;
    border: none;
    border-radius: 0;
    background: transparent;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    border-right: 1px solid rgba(42, 63, 95, 0.5);
  }
  .nav-btn:last-child { border-right: none; }
  .nav-btn.active {
    background: rgba(16, 185, 129, 0.16);
    color: #6ee7b7;
    box-shadow: inset 0 2px 0 var(--accent);
  }
  .hidden { display: none !important; }
</style>
</head>
<body>
<div class="app">
  <!-- Header -->
  <header class="hdr">
    <div class="hdr-title">🎾 ソフトテニス戦術シミュレーター</div>
    <div style="display:flex;align-items:center;gap:5px;">
      <span id="touchStatus" class="badge-ok">✓ 準備完了</span>
      <button type="button" data-act="toggle-expand" id="btnExpandTop" style="padding:4px 7px;font-size:11px;">⛶ 拡大</button>
      <button type="button" data-act="toggle-orient" id="btnOrientTop" style="padding:4px 7px;font-size:11px;">🔄 横表示</button>
    </div>
  </header>

  <!-- Score & Rotation Bar -->
  <div class="score-strip" id="scoreStrip">
    <div class="score-box">
      <span class="team-tag team-self">自分</span>
      <button type="button" class="pt-btn" data-act="pt-self" id="btnPtSelf">0</button>
      <span class="game-pill" id="gameScoreDisp">G 0 - 0 (5G)</span>
      <button type="button" class="pt-btn" data-act="pt-opp" id="btnPtOpp">0</button>
      <span class="team-tag team-opp">相手</span>
    </div>
    <div class="rot-info">
      <span id="srvDisp">S:自後 / R:相後</span>
      <button type="button" data-act="next-rot" style="padding:3px 6px;font-size:10px;">ローテ</button>
      <button type="button" data-act="reset-pt" style="padding:3px 6px;font-size:10px;">0-0</button>
    </div>
  </div>

  <!-- Main Content -->
  <main class="main">
    <!-- TAB 1: COURT & SIMULATION -->
    <section id="tab-court" class="tab-pane active">
      <!-- Rally Timeline & Playback Speed -->
      <div class="tl-bar">
        <div class="step-pills" id="stepPills"></div>
        <div class="play-controls">
          <div style="display:flex;align-items:center;gap:4px;">
            <button type="button" data-act="play-all" id="btnPlayAll" class="active" style="padding:4px 8px;font-size:11px;">▶ 連続再生</button>
            <button type="button" data-act="play-one" id="btnPlayOne" style="padding:4px 7px;font-size:11px;">1球確認</button>
          </div>
          <div class="speed-group" title="再生スピード">
            <button type="button" class="spd-btn" data-act="set-speed" data-val="0.5">0.5x</button>
            <button type="button" class="spd-btn" data-act="set-speed" data-val="0.75">0.75x</button>
            <button type="button" class="spd-btn active" data-act="set-speed" data-val="1">1.0x</button>
            <button type="button" class="spd-btn" data-act="set-speed" data-val="1.5">1.5x</button>
          </div>
          <button type="button" data-act="add-step" class="active-blue" style="padding:4px 8px;font-size:11px;">＋次球</button>
        </div>
      </div>

      <!-- Previous Ball Indicator (Shown on 2nd ball onwards) -->
      <div id="prevBallBanner" class="prev-banner hidden">
        <span id="prevBallText">前球: 1球目(サーブ1st) 着弾位置表示中</span>
        <button type="button" data-act="toggle-prev-ghost" id="btnPrevGhost" style="padding:2px 6px;font-size:10px;">前球表示:ON</button>
      </div>

      <!-- Official Dimensions Court SVG -->
      <div class="court-wrap" id="courtWrap">
        <svg id="courtSvg" class="court-svg" viewBox="0 0 276 566" xmlns="http://www.w3.org/2000/svg">
          <g id="courtRoot">
            <!-- Outer Run-off -->
            <rect x="0" y="0" width="276" height="566" fill="#13422b"/>
            <!-- Playing Surface (10.97m x 23.77m = 219.4 x 475.4) -->
            <rect x="28.3" y="45.3" width="219.4" height="475.4" fill="#1e6b43"/>

            <!-- Baseline Deep Zones (1.2m inside each baseline) -->
            <rect x="28.3" y="45.3" width="219.4" height="24" fill="rgba(251, 191, 36, 0.12)"/>
            <rect x="28.3" y="496.7" width="219.4" height="24" fill="rgba(251, 191, 36, 0.12)"/>

            <!-- Court Lines -->
            <!-- Doubles Sidelines -->
            <line x1="28.3" y1="45.3" x2="28.3" y2="520.7" stroke="#ffffff" stroke-width="2"/>
            <line x1="247.7" y1="45.3" x2="247.7" y2="520.7" stroke="#ffffff" stroke-width="2"/>
            <!-- Singles / Service Sidelines (Extended to Baselines) -->
            <line x1="55.7" y1="45.3" x2="55.7" y2="520.7" stroke="#ffffff" stroke-width="1.6"/>
            <line x1="220.3" y1="45.3" x2="220.3" y2="520.7" stroke="#ffffff" stroke-width="1.6"/>
            <!-- Service Lines (6.40m = 128 from net y=283) -->
            <line x1="55.7" y1="155" x2="220.3" y2="155" stroke="#ffffff" stroke-width="1.8"/>
            <line x1="55.7" y1="411" x2="220.3" y2="411" stroke="#ffffff" stroke-width="1.8"/>
            <!-- Center Service Line -->
            <line x1="138" y1="155" x2="138" y2="411" stroke="#ffffff" stroke-width="1.6"/>
            <!-- Thicker Baselines -->
            <line x1="27.3" y1="45.3" x2="248.7" y2="45.3" stroke="#ffffff" stroke-width="3.2"/>
            <line x1="27.3" y1="520.7" x2="248.7" y2="520.7" stroke="#ffffff" stroke-width="3.2"/>
            <!-- Center Marks -->
            <line x1="138" y1="45.3" x2="138" y2="53.3" stroke="#ffffff" stroke-width="2"/>
            <line x1="138" y1="512.7" x2="138" y2="520.7" stroke="#ffffff" stroke-width="2"/>

            <!-- Net & Outside Posts -->
            <line x1="20.3" y1="283" x2="255.7" y2="283" stroke="#e2e8f0" stroke-width="2.4" stroke-dasharray="5,3"/>
            <circle cx="20.3" cy="283" r="3.8" fill="#cbd5e1" stroke="#0f172a" stroke-width="1.2"/>
            <circle cx="255.7" cy="283" r="3.8" fill="#cbd5e1" stroke="#0f172a" stroke-width="1.2"/>

            <!-- Dynamic Layers (All pointer-events: none) -->
            <g id="layerCoverage"></g>
            <g id="layerBlindSpots"></g>
            <g id="layerRecommended"></g>
            <g id="layerPrevBall"></g>
            <g id="layerPredictions"></g>
            <g id="layerTrajectory"></g>
            <g id="layerAnimBall"></g>

            <!-- Topmost Interactive Player Layer -->
            <g id="layerPlayers"></g>
          </g>
        </svg>
      </div>

      <!-- Tactical Diagnosis & Recommended Position -->
      <div class="diag-box" id="diagBox">
        <div class="diag-title">
          <span id="formLabel">陣形: 雁行陣 vs 雁行陣</span>
          <button type="button" data-act="apply-rec" style="padding:2px 7px;font-size:10px;" class="active">📍 推奨位置へ</button>
        </div>
        <div id="diagText" style="color:#cbd5e1;">打者の位置と球の深さ・伸びからカバー範囲と死角を算出中</div>
      </div>

      <!-- Quick Shot / Depth / Stretch Controls -->
      <div class="quick-card">
        <div class="q-row">
          <span class="q-lbl">打者・球種</span>
          <div class="btn-group" id="hitterBtns">
            <button type="button" data-act="set-hitter" data-val="self_b">自後衛</button>
            <button type="button" data-act="set-hitter" data-val="self_f">自前衛</button>
            <button type="button" data-act="set-hitter" data-val="opp_b">相後衛</button>
            <button type="button" data-act="set-hitter" data-val="opp_f">相前衛</button>
          </div>
        </div>
        <div class="q-row">
          <span class="q-lbl">ショット</span>
          <div class="btn-group" id="shotBtns">
            <button type="button" data-act="set-shot" data-val="serve1">1stS</button>
            <button type="button" data-act="set-shot" data-val="serve2">2ndS</button>
            <button type="button" data-act="set-shot" data-val="stroke">ストローク</button>
            <button type="button" data-act="set-shot" data-val="volley">ボレー</button>
            <button type="button" data-act="set-shot" data-val="lob">ロブ</button>
            <button type="button" data-act="set-shot" data-val="smash">スマッシュ</button>
          </div>
        </div>
        <div class="q-row">
          <span class="q-lbl">コース</span>
          <div class="btn-group" id="courseBtns">
            <button type="button" data-act="set-course" data-val="auto">自動予測</button>
            <button type="button" data-act="set-course" data-val="cross">クロス</button>
            <button type="button" data-act="set-course" data-val="straight">ストレート</button>
            <button type="button" data-act="set-course" data-val="short">ショート</button>
            <button type="button" data-act="set-course" data-val="center">センター</button>
            <button type="button" data-act="set-course" data-val="lob">ロブ</button>
          </div>
        </div>
        <div class="q-row">
          <span class="q-lbl">球の深さ</span>
          <button type="button" data-act="set-depth" data-val="25" style="padding:4px 6px;font-size:10px;">浅い</button>
          <button type="button" data-act="set-depth" data-val="60" style="padding:4px 6px;font-size:10px;">普通</button>
          <button type="button" data-act="set-depth" data-val="95" style="padding:4px 6px;font-size:10px;">深い</button>
          <input type="range" id="rngDepth" data-act="rng-depth" min="5" max="100" value="85">
          <span class="val-tag" id="lblDepth">85%</span>
        </div>
        <div class="q-row">
          <span class="q-lbl">球の伸び</span>
          <button type="button" data-act="set-stretch" data-val="25" style="padding:4px 6px;font-size:10px;">弱</button>
          <button type="button" data-act="set-stretch" data-val="60" style="padding:4px 6px;font-size:10px;">普通</button>
          <button type="button" data-act="set-stretch" data-val="92" style="padding:4px 6px;font-size:10px;">強伸</button>
          <input type="range" id="rngStretch" data-act="rng-stretch" min="0" max="100" value="88">
          <span class="val-tag" id="lblStretch">+3.7m</span>
        </div>
      </div>
    </section>

    <!-- TAB 2: TACTICAL DETAILS & SETTINGS -->
    <section id="tab-settings" class="tab-pane">
      <div class="card">
        <div class="card-h"><span>👁 シミュレーション表示レイヤー</span></div>
        <div class="grid-2">
          <button type="button" data-act="toggle-opt" data-key="showCov" id="optShowCov" class="active">🛡 カバー範囲: ON</button>
          <button type="button" data-act="toggle-opt" data-key="showBlind" id="optShowBlind" class="active">🎯 死角・狙い目: ON</button>
          <button type="button" data-act="toggle-opt" data-key="showPred" id="optShowPred" class="active">🧭 コース予測: ON</button>
          <button type="button" data-act="toggle-opt" data-key="showRec" id="optShowRec" class="active">📍 推奨位置: ON</button>
        </div>
      </div>

      <div class="card">
        <div class="card-h"><span>🏃 打者の体勢・バランス設定</span></div>
        <div class="btn-group" id="stanceBtns">
