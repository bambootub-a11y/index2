</div>

<script>
(function() {
  'use strict';

  var STORAGE_KEY = 'st_tactics_sim_only_v1';
  var $ = function(id) { return document.getElementById(id); };

  // Court Official Logical Constants (276 x 566, 1m = 20 units)
  var COURT = {
    W: 276, H: 566,
    CX: 138, NET_Y: 283,
    LEFT_D: 28.3, RIGHT_D: 247.7,
    LEFT_S: 55.7, RIGHT_S: 220.3,
    TOP_BL: 45.3, BOT_BL: 520.7,
    TOP_SL: 155, BOT_SL: 411
  };

  var PLAYER_META = {
    self_b: { label: '自後', full: '自分後衛', team: 'self', role: 'B', color: '#0284c7', stroke: '#bae6fd' },
    self_f: { label: '自前', full: '自分前衛', team: 'self', role: 'F', color: '#0ea5e9', stroke: '#e0f2fe' },
    opp_b:  { label: '相後', full: '相手後衛', team: 'opp',  role: 'B', color: '#e11d48', stroke: '#fecdd3' },
    opp_f:  { label: '相前', full: '相手前衛', team: 'opp',  role: 'F', color: '#f43f5e', stroke: '#ffe4e6' }
  };

  var SHOT_META = {
    serve1: { name: '1stサーブ', stretchMult: 1.25, arc: 14 },
    serve2: { name: '2ndサーブ', stretchMult: 1.05, arc: 26 },
    stroke: { name: 'ストローク', stretchMult: 1.0,  arc: 20 },
    volley: { name: 'ボレー',     stretchMult: 1.15, arc: 10 },
    lob:    { name: 'ロブ',       stretchMult: 0.75, arc: 52 },
    smash:  { name: 'スマッシュ', stretchMult: 1.3,  arc: 12 }
  };

  var STANCE_META = {
    good:    { name: '余裕あり',   covMult: 1.12, color: '#34d399' },
    normal:  { name: '普通',       covMult: 1.00, color: '#f8fafc' },
    off:     { name: 'やや崩れ',   covMult: 0.84, color: '#fbbf24' },
    stretch: { name: '大きく崩れ', covMult: 0.68, color: '#f87171' }
  };

  function defaultPlayers() {
    return {
      self_b: { x: 196, y: 536, stance: 'good' },
      self_f: { x: 96,  y: 348, stance: 'normal' },
      opp_b:  { x: 76,  y: 32,  stance: 'normal' },
      opp_f:  { x: 178, y: 215, stance: 'normal' }
    };
  }

  function createStep(num, hitterId, shotType, course, depth, stretch, playersObj) {
    var pCopy = JSON.parse(JSON.stringify(playersObj));
    var st = {
      num: num,
      hitterId: hitterId || 'self_b',
      shotType: shotType || 'serve1',
      course: course || 'cross',
      depth: typeof depth === 'number' ? depth : 85,
      stretch: typeof stretch === 'number' ? stretch : 88,
      bounceX: 74,
      bounceY: 162,
      players: pCopy
    };
    recalcBounce(st);
    return st;
  }

  var state = {
    activeTab: 'court',
    expanded: false,
    horiz: false,
    flipView: false,
    playSpeed: 1.0,
    showPrevGhost: true,
    opts: {
      showCov: true,
      showBlind: true,
      showPred: true,
      showRec: true
    },
    match: {
      format: 5,
      gSelf: 0,
      gOpp: 0,
      pSelf: 0,
      pOpp: 0,
      rotIdx: 0
    },
    currentIdx: 0,
    steps: [],
    logs: []
  };

  var animState = {
    running: false,
    rafId: null
  };

  function initData() {
    var initP = defaultPlayers();
    state.steps = [
      createStep(1, 'self_b', 'serve1', 'cross', 86, 88, initP)
    ];
    try {
      var saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        var parsed = JSON.parse(saved);
        if (parsed && Array.isArray(parsed.logs)) state.logs = parsed.logs;
        if (parsed && typeof parsed.horiz === 'boolean') state.horiz = parsed.horiz;
        if (parsed && typeof parsed.playSpeed === 'number') state.playSpeed = parsed.playSpeed;
      }
    } catch (e) {}
  }

  function persist() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        logs: state.logs,
        horiz: state.horiz,
        playSpeed: state.playSpeed
      }));
    } catch (e) {}
  }

  function curStep() {
    return state.steps[state.currentIdx] || state.steps[0];
  }

  function clamp(v, min, max) {
    return Math.max(min, Math.min(max, v));
  }

  // Coordinate mapping for View Flip (if flipView is true, rotate 180 around center)
  function mapPt(x, y) {
    if (!state.flipView) return { x: x, y: y };
    return { x: COURT.W - x, y: COURT.H - y };
  }

  function unmapPt(x, y) {
    if (!state.flipView) return { x: x, y: y };
    return { x: COURT.W - x, y: COURT.H - y };
  }

  // Calculate bounce target from hitter, shotType, course, depth
  function recalcBounce(st) {
    var hitter = st.players[st.hitterId];
    var hTeam = PLAYER_META[st.hitterId].team;
    var targetIsTop = (hTeam === 'self'); // self hits toward top (y=45.3..283)

    // Depth 0..100 -> distance from net (0m to 11.885m baseline)
    // 25% = service line (6.4m), 60% = mid-deep (9.1m), 95% = 0.35m inside BL, 100% = on BL
    var distFromNet;
    if (st.shotType === 'serve1' || st.shotType === 'serve2') {
      // Serve lands inside service box (up to 6.40m = 128px from net)
      var srvRatio = clamp(st.depth / 100, 0.25, 1.0);
      distFromNet = 52 + srvRatio * 74; // max 126px (just inside service line 128px)
    } else if (st.course === 'short') {
      distFromNet = 26 + (st.depth / 100) * 44; // 1.3m to 3.5m
    } else {
      var dNorm = clamp(st.depth / 100, 0.05, 1.0);
      if (dNorm <= 0.25) {
        distFromNet = 36 + (dNorm / 0.25) * 92; // up to service line 128px
      } else {
        // 128px to 237.7px (baseline)
        distFromNet = 128 + ((dNorm - 0.25) / 0.75) * 109.7;
      }
    }

    var by = targetIsTop ? (COURT.NET_Y - distFromNet) : (COURT.NET_Y + distFromNet);
    var bx = COURT.CX;
    var isHitterRight = hitter.x >= COURT.CX;

    var course = st.course;
    if (course === 'auto') {
      var preds = calcPredictions(st);
      course = preds.length ? preds[0].course : 'cross';
    }

    if (st.shotType === 'serve1' || st.shotType === 'serve2') {
      // Diagonal service box
      if (isHitterRight) {
        // Hit from deuce side (right) -> lands in top-left service box (55.7 .. 138)
        if (course === 'straight' || course === 'center') bx = 131;
        else if (course === 'short') bx = 66;
        else bx = 72; // wide cross
      } else {
        // Hit from ad side (left) -> lands in top-right service box (138 .. 220.3)
        if (course === 'straight' || course === 'center') bx = 145;
        else if (course === 'short') bx = 210;
        else bx = 204;
      }
      if (!targetIsTop) {
        bx = COURT.W - bx;
      }
    } else {
      var leftEdge = COURT.LEFT_D + 12;
      var rightEdge = COURT.RIGHT_D - 12;
      if (course === 'cross') {
        bx = isHitterRight ? leftEdge + 8 : rightEdge - 8;
      } else if (course === 'straight') {
        bx = isHitterRight ? rightEdge - 6 : leftEdge + 6;
      } else if (course === 'short') {
        bx = isHitterRight ? COURT.LEFT_D + 6 : COURT.RIGHT_D - 6;
      } else if (course === 'center') {
        bx = COURT.CX + (isHitterRight ? -8 : 8);
      } else if (course === 'lob') {
        bx = isHitterRight ? leftEdge + 18 : rightEdge - 18;
      }
    }

    st.bounceX = clamp(bx, COURT.LEFT_D + 4, COURT.RIGHT_D - 4);
    st.bounceY = clamp(by, COURT.TOP_BL + 1, COURT.BOT_BL - 1);
  }

  // Stretch endpoint calculation (up to +4.2m = 84px post-bounce)
  function calcStretchEnd(st) {
    var hitter = st.players[st.hitterId];
    var dx = st.bounceX - hitter.x;
    var dy = st.bounceY - hitter.y;
    var len = Math.hypot(dx, dy) || 1;
    var mult = (SHOT_META[st.shotType] ? SHOT_META[st.shotType].stretchMult : 1.0);
    // Max stretch = 4.2m (84px) at 100%
    var stretchPx = (st.stretch / 100) * 84 * mult;
    return {
      ex: clamp(st.bounceX + (dx / len) * stretchPx, 8, COURT.W - 8),
      ey: clamp(st.bounceY + (dy / len) * stretchPx, 6, COURT.H - 6),
      meters: (stretchPx / 20).toFixed(1)
    };
  }

  // Defensive Coverage Ellipses (Incorporates Stance + Opponent Ball Depth & Stretch)
  function calcCoverage(st) {
    var hTeam = PLAYER_META[st.hitterId].team;
    var defTeam = (hTeam === 'self') ? 'opp' : 'self';
    var sMult = SHOT_META[st.shotType].stretchMult;
    // Pressure from depth & stretch shrinks defender reach
    var pressure = ((st.depth / 100) * 0.45 + (st.stretch / 100) * 0.55) * sMult;
    var defShrink = clamp(1.0 - pressure * 0.34, 0.58, 1.04);

    var res = {};
    Object.keys(PLAYER_META).forEach(function(id) {
      var meta = PLAYER_META[id];
      var p = st.players[id];
      var baseRx = (meta.role === 'B') ? 48 : 44;
      var baseRy = (meta.role === 'B') ? 38 : 32;
      var stMult = STANCE_META[p.stance].covMult;
      var teamMult = (meta.team === defTeam) ? defShrink : 1.0;
      res[id] = {
        rx: baseRx * stMult * teamMult,
        ry: baseRy * stMult * teamMult,
        isDef: (meta.team === defTeam)
      };
    });
    return res;
  }

  // Detect Open Court Blind Spots on Defending Side
  function calcBlindSpots(st, covMap) {
    var hTeam = PLAYER_META[st.hitterId].team;
    var defTeam = (hTeam === 'self') ? 'opp' : 'self';
    var defIds = (defTeam === 'opp') ? ['opp_b', 'opp_f'] : ['self_b', 'self_f'];
    var isTop = (defTeam === 'opp');

    var candidates = isTop ? [
      { x: 52,  y: 78,  name: 'バック奥' },
      { x: 224, y: 78,  name: 'フォア奥' },
      { x: 138, y: 92,  name: '深い中央' },
      { x: 50,  y: 185, name: '左サイド' },
      { x: 226, y: 185, name: '右サイド' },
      { x: 138, y: 205, name: 'センター' }
    ] : [
      { x: 52,  y: 488, name: 'フォア奥' },
      { x: 224, y: 488, name: 'バック奥' },
      { x: 138, y: 474, name: '深い中央' },
      { x: 50,  y: 381, name: '左サイド' },
      { x: 226, y: 381, name: '右サイド' },
      { x: 138, y: 361, name: 'センター' }
    ];

    var spots = [];
    candidates.forEach(function(pt) {
      var minNorm = 99;
      defIds.forEach(function(did) {
        var dp = st.players[did];
        var c = covMap[did];
        var d = Math.hypot((pt.x - dp.x) / c.rx, (pt.y - dp.y) / c.ry);
        if (d < minNorm) minNorm = d;
      });
      if (minNorm > 1.06) {
        spots.push({ x: pt.x, y: pt.y, name: pt.name, score: minNorm });
      }
    });
    spots.sort(function(a, b) { return b.score - a.score; });
    return spots.slice(0, 3);
  }

  // Automatic Shot Course Prediction (Top 3)
  function calcPredictions(st) {
    var hitter = st.players[st.hitterId];
    var hTeam = PLAYER_META[st.hitterId].team;
    var defIds = (hTeam === 'self') ? ['opp_b', 'opp_f'] : ['self_b', 'self_f'];
    var targetYDeep = (hTeam === 'self') ? 68 : 498;
    var targetYMid  = (hTeam === 'self') ? 168 : 398;
    var targetYShort = (hTeam === 'self') ? 228 : 338;
    var isRight = hitter.x >= COURT.CX;

    var options = [
      { course: 'cross',    label: 'クロス',     x: isRight ? 46 : 230,  y: targetYDeep },
      { course: 'straight', label: 'ストレート', x: isRight ? 232 : 44,  y: targetYDeep },
      { course: 'center',   label: 'センター',   x: 138,                 y: targetYMid },
      { course: 'short',    label: 'ショート',   x: isRight ? 40 : 236,  y: targetYShort },
      { course: 'lob',      label: 'ロブ',       x: isRight ? 58 : 218,  y: targetYDeep - (hTeam === 'self' ? 12 : -12) }
    ];

    var covMap = calcCoverage(st);
    options.forEach(
